<Window x:Class="Acp.SessionAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskGuest" Height="768" Width="1376"
        WindowStartupLocation="CenterScreen"
        Background="#EBF3F6" FontFamily="{StaticResource DgFont}" Foreground="{StaticResource DgTextBrush}">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DgBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource DgMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DgMutedBrush}"/>
            <Setter Property="Margin" Value="2,10,0,8"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource DgMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- W70: nav rebuilt to the Gemini master geometry — pill rows
             (radius 26), 294px sidebar, selected = navy pill + white
             icon/text. Icons are drawn line shapes (one family,
             stroke = the button's foreground). -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,15"/>
            <Setter Property="Margin" Value="22,4,22,4"/>
            <Setter Property="FontSize" Value="16.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DgTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="26"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DCE9F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DgBlueBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DgSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DgTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource DgBorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DgRedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="294"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (W70: measured from the Windows Home & Devices master) -->
        <Border Grid.Column="0" Background="#EBF3F6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,36,16,58">
                    <Border Width="60" Height="60" Background="White" CornerRadius="14" BorderBrush="{StaticResource DgBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <Image Width="52" Height="52" Source="deskguest-mark-tight.png" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DeskGuest" FontSize="27" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button x:Name="NavOverview" Style="{StaticResource NavButton}" Tag="overview" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="24" Height="24" VerticalAlignment="Center">
                                <Rectangle Canvas.Left="3" Canvas.Top="4" Width="18" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Line X1="1" Y1="20" X2="23" Y2="20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                            </Canvas>
                            <TextBlock Text="This Device" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavRoster" Style="{StaticResource NavButton}" Tag="roster" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="24" Height="24" VerticalAlignment="Center">
                                <Line X1="9" Y1="6" X2="21" Y2="6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Line X1="9" Y1="12" X2="21" Y2="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Line X1="9" Y1="18" X2="21" Y2="18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Ellipse Canvas.Left="3" Canvas.Top="4.4" Width="3.2" Height="3.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                <Ellipse Canvas.Left="3" Canvas.Top="10.4" Width="3.2" Height="3.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                <Ellipse Canvas.Left="3" Canvas.Top="16.4" Width="3.2" Height="3.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Canvas>
                            <TextBlock Text="All Devices" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAgents" Style="{StaticResource NavButton}" Tag="pairing" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="24" Height="24" VerticalAlignment="Center">
                                <Rectangle Canvas.Left="4" Canvas.Top="7" Width="16" Height="13" RadiusX="3" RadiusY="3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Line X1="12" Y1="7" X2="12" Y2="3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Ellipse Canvas.Left="10.2" Canvas.Top="1.2" Width="3.6" Height="3.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.6"/>
                                <Ellipse Canvas.Left="8" Canvas.Top="11" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                <Ellipse Canvas.Left="13" Canvas.Top="11" Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Canvas>
                            <TextBlock Text="AI Agents" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAudit" Style="{StaticResource NavButton}" Tag="audit" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="24" Height="24" VerticalAlignment="Center">
                                <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Line X1="12" Y1="7" X2="12" Y2="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Line X1="12" Y1="12" X2="16.5" Y2="14.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                            </Canvas>
                            <TextBlock Text="History" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="settings" Click="Nav_Click">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="24" Height="24" VerticalAlignment="Center">
                                <Ellipse Canvas.Left="8.6" Canvas.Top="8.6" Width="6.8" Height="6.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Line X1="17.4" Y1="12" X2="20.5" Y2="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Line X1="6.6" Y1="12" X2="3.5" Y2="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Line X1="14.7" Y1="7.32" X2="16.25" Y2="4.64" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Line X1="9.3" Y1="7.32" X2="7.75" Y2="4.64" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Line X1="14.7" Y1="16.68" X2="16.25" Y2="19.36" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                                <Line X1="9.3" Y1="16.68" X2="7.75" Y2="19.36" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.8"/>
                            </Canvas>
                            <TextBlock Text="Settings" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- Secondary destinations: real pages the Home master
                     does not draw; kept reachable, drawn in the same
                     icon family at caption size. -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button x:Name="NavPresence" Style="{StaticResource NavButton}" Content="Presence" Tag="presence" Click="Nav_Click" FontSize="14.5" Padding="56,3" Margin="22,1,22,1"/>
                    <Button x:Name="NavGuardrails" Style="{StaticResource NavButton}" Content="Guardrails" Tag="guardrails" Click="Nav_Click" FontSize="14.5" Padding="56,3" Margin="22,1,22,1"/>
                    <Button x:Name="NavSessions" Style="{StaticResource NavButton}" Content="Sessions" Tag="sessions" Click="Nav_Click" FontSize="14.5" Padding="56,3" Margin="22,1,22,1"/>
                    <Button x:Name="NavEnterprise" Style="{StaticResource NavButton}" Content="Company" Tag="enterprise" Click="Nav_Click" FontSize="14.5" Padding="56,3" Margin="22,1,22,1"/>
                    <Button x:Name="NavServices" Style="{StaticResource NavButton}" Content="Services" Tag="services" Click="Nav_Click" FontSize="14.5" Padding="56,3" Margin="22,1,22,1"/>
                    <Button x:Name="NavUpdates" Style="{StaticResource NavButton}" Content="Updates" Tag="updates" Click="Nav_Click" FontSize="14.5" Padding="56,3" Margin="22,1,22,1"/>
                    <Button x:Name="NavAbout" Style="{StaticResource NavButton}" Content="Help" Tag="about" Click="Nav_Click" FontSize="14.5" Padding="56,3" Margin="22,1,22,1"/>
                </StackPanel>
                <!-- W8 (record §4): this PC's own state sentence lives
                     in the sidebar foot; the build label lives in
                     About only — never in owner chrome. -->
                <StackPanel Grid.Row="4" Margin="24,0,16,22">
                    <TextBlock x:Name="MeshThisPcName" Text="This PC" FontSize="14.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MeshThisPcState" Text="Idle" FontSize="12.5" Foreground="{StaticResource DgMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Page host: content panel (W70 — the master's rounded,
             bordered canvas inset from the sidebar) -->
        <Border Grid.Column="1" Background="{StaticResource DgCanvasBrush}" BorderBrush="{StaticResource DgBorderBrush}" BorderThickness="1" CornerRadius="16" Margin="0,6,6,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="PageHost" Margin="26,20,26,10"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
