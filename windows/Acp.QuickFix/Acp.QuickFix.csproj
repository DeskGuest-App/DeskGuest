<Project Sdk="Microsoft.NET.Sdk">

  <!-- DeskGuest: Quick Fix — standalone artefact (Mimicry Proof build,
       2026-11-24). A1 Home (Host / Join -> Session / Room) as a real
       WPF window in the product's own stack: net10.0-windows, product
       palette tokens (DeskGuestTheme.xaml of record), the product's
       real A3 Greeter asset, Plus Jakarta Sans embedded as the product
       would carry it. NOT part of AcpWindows.slnx; builds standalone. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeskGuestQuickFix</AssemblyName>
    <RootNamespace>Acp.QuickFix</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\*.png" />
  </ItemGroup>

</Project>
