<Window x:Class="Acp.QuickFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskGuest: Quick Fix"
        Width="1376" Height="768"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Left="272" Top="156"
        Background="#E8EFF5"
        FontFamily="./Fonts/#Plus Jakarta Sans"
        TextOptions.TextFormattingMode="Display">
    <!-- A1 — Quick Fix Home (Step 1: Host or Join), light theme.
         Geometry and colours measured from the Gemini painting
         A1_QuickFix_Home_Step1_Light.png (1376x768) — Mimicry Proof.
         Palette anchors: DeskGuestTheme.xaml tokens (DgActionBlue
         #2F8BC9, DgTeal #438E8E, DgTextPrimary #0F2537). -->
    <Canvas Width="1376" Height="768">
        <!-- ===== Title bar (painted h 44, fill #EDF2F7) ===== -->
        <Border Canvas.Left="0" Canvas.Top="0" Width="1376" Height="44"
                Background="#EDF2F7" BorderBrush="#DCE5EC" BorderThickness="0,0,0,1"/>
        <Image Canvas.Left="11" Canvas.Top="12" Width="20" Height="20"
               Source="Assets/app-icon.png" Stretch="Uniform"/>
        <TextBlock Canvas.Left="38" Canvas.Top="11" Text="DeskGuest: Quick Fix"
                   FontSize="15" FontWeight="Normal" Foreground="#2A3238"/>
        <!-- window glyphs (painted: minus ~1247, square ~1300, X ~1352, stroke ~1.6) -->
        <Path Data="M 1239,22 H 1255" Stroke="#0F2537" StrokeThickness="1.6"/>
        <Path Data="M 1293,15 H 1307 V 29 H 1293 Z" Stroke="#0F2537" StrokeThickness="1.6" Fill="Transparent"/>
        <Path Data="M 1344,14.5 L 1359,29.5 M 1359,14.5 L 1344,29.5" Stroke="#0F2537" StrokeThickness="1.6"/>
        <Button Canvas.Left="1217" Canvas.Top="0" Width="46" Height="44" Opacity="0"
                Click="OnMinimize" ToolTip="Minimise"/>
        <Button Canvas.Left="1263" Canvas.Top="0" Width="46" Height="44" Opacity="0"
                Click="OnMaximise" ToolTip="Maximise"/>
        <Button Canvas.Left="1330" Canvas.Top="0" Width="46" Height="44" Opacity="0"
                Click="OnClose" ToolTip="Close"/>

        <!-- ===== Mascot: the product's real A3 Greeter wave asset,
             white-keyed to alpha (asset prep, see REPORT.md) ===== -->
        <Ellipse Canvas.Left="612" Canvas.Top="250" Width="152" Height="15" Fill="#C7D5E1" Opacity="0.55">
            <Ellipse.Effect>
                <BlurEffect Radius="6"/>
            </Ellipse.Effect>
        </Ellipse>
        <Image Canvas.Left="574" Canvas.Top="49" Width="228" Height="228"
               Source="Assets/greeter-wave-alpha.png" Stretch="Fill"/>

        <!-- ===== Headline + tagline ===== -->
        <!-- ScaleX: the painted face is ~15% narrower than Plus Jakarta
             Sans at matched cap height (measured). Compensation is
             disclosed in REPORT.md as a typeface-metrics residual. -->
        <TextBlock Canvas.Left="0" Canvas.Top="267" Width="1376" TextAlignment="Center"
                   Text="DeskGuest: Quick Fix" FontSize="57" FontWeight="ExtraBold"
                   Foreground="#0F2537" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <ScaleTransform ScaleX="0.85"/>
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock Canvas.Left="0" Canvas.Top="340" Width="1376" TextAlignment="Center"
                   Text="Two taps. No account, no cloud, nothing left behind."
                   FontSize="22" FontWeight="SemiBold" Foreground="#2C3A47"
                   RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <ScaleTransform ScaleX="0.947"/>
            </TextBlock.RenderTransform>
        </TextBlock>

        <!-- ===== Host card (painted x335 y412 w340 h267) ===== -->
        <Border Canvas.Left="335" Canvas.Top="412" Width="340" Height="267"
                Background="White" CornerRadius="14"
                BorderBrush="#E7EEF4" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="7" Direction="270"
                                  Opacity="0.24" Color="#3D4A56"/>
            </Border.Effect>
            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="Host" FontSize="35" FontWeight="Bold" Foreground="#0F2537"
                               TextAlignment="Center" Margin="0,32,0,0"/>
                    <TextBlock Text="Start a help session or gather people in a room right now."
                               FontSize="19.5" Foreground="#2B3640" TextAlignment="Center"
                               TextWrapping="Wrap" Width="284" LineHeight="26"
                               LineStackingStrategy="BlockLineHeight" Margin="0,10,0,0"/>
                </StackPanel>
                <Border Width="278" Height="51" CornerRadius="8" Background="#2684C2"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32">
                    <TextBlock Text="Host" FontSize="20" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Join card (painted x701 y412 w340 h267) ===== -->
        <Border Canvas.Left="701" Canvas.Top="412" Width="340" Height="267"
                Background="White" CornerRadius="14"
                BorderBrush="#E7EEF4" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="7" Direction="270"
                                  Opacity="0.24" Color="#3D4A56"/>
            </Border.Effect>
            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="Join" FontSize="35" FontWeight="Bold" Foreground="#0F2537"
                               TextAlignment="Center" Margin="0,32,0,0"/>
                    <TextBlock Text="Enter a one-time code or paste an invite link someone sent you."
                               FontSize="19.5" Foreground="#2B3640" TextAlignment="Center"
                               TextWrapping="Wrap" Width="284" LineHeight="26"
                               LineStackingStrategy="BlockLineHeight" Margin="0,10,0,0"/>
                </StackPanel>
                <Border Width="278" Height="51" CornerRadius="8" Background="#488C8D"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32">
                    <TextBlock Text="Join" FontSize="20" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Bottom strip (painted x172 y712 w1032 h44) ===== -->
        <Border Canvas.Left="172" Canvas.Top="712" Width="1032" Height="44"
                Background="#E9F0F6" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="7" Direction="270"
                                  Opacity="0.22" Color="#3D4A56"/>
            </Border.Effect>
            <Grid Margin="0,-6,0,0">
                <TextBlock Text="A1 • Step 1" FontSize="16.5" FontWeight="Medium" Foreground="#66727C"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="Help" FontSize="16.5" FontWeight="SemiBold" Foreground="#35606A"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,23,0"/>
            </Grid>
        </Border>

        <!-- window frame line (painted 1px edge) -->
        <Rectangle Width="1376" Height="768" Stroke="#C4D2DE" StrokeThickness="1"
                   IsHitTestVisible="False"/>
    </Canvas>
</Window>
