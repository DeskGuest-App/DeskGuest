<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- The product version, stamped into every assembly (Block H
         fix: the tree shipped 0.1.0 in Directory.Build.props long
         after the product had moved on, so every surface that read
         an assembly version — host snapshot, MCP serverInfo, the
         About page — reported 0.1.0.0). ONE source: bump here. -->
    <Version>1.0.0</Version>
    <Company>DeskGuest</Company>
    <Product>DeskGuest</Product>
  </PropertyGroup>
</Project>
