<Window x:Class="DeskGuest.RecoveryProof.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskGuest — Settings"
        Width="1440" Height="900"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="./Fonts/#Plus Jakarta Sans"
        Background="#F2F6F9">
    <Window.Resources>
        <!-- Total-spec tokens (deskguest-tokens.css), light theme defaults;
             code-behind swaps values for the dark theme. -->
        <SolidColorBrush x:Key="BgBrush" Color="#F2F6F9"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#E6EEF4"/>
        <SolidColorBrush x:Key="TextBrush" Color="#0F2537"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#486175"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D5E1EA"/>
        <SolidColorBrush x:Key="TitlebarBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="RailBrush" Color="#0F2537"/>
        <SolidColorBrush x:Key="RailSearchBrush" Color="#163147"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#2F8BC9"/>
        <SolidColorBrush x:Key="TealBrush" Color="#438E8E"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#E5A93B"/>
        <SolidColorBrush x:Key="IconBrush" Color="#0F2537"/>
        <SolidColorBrush x:Key="IconTileBrush" Color="#E6EEF4"/>
        <SolidColorBrush x:Key="BadgeTealBg" Color="#E1EDED"/>
        <SolidColorBrush x:Key="BadgeTealText" Color="#438E8E"/>
        <SolidColorBrush x:Key="BadgeMutedBg" Color="#E6EEF4"/>
        <SolidColorBrush x:Key="BadgeMutedText" Color="#486175"/>
        <SolidColorBrush x:Key="GoldTileBrush" Color="#FAEED8"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                                      Color="#0F2537" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource BlueBrush}" CornerRadius="10" Padding="16,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietBtn" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailItem" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="RailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#A8C0D4"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Titlebar (floor window chrome) ===== -->
        <Border Grid.Row="0" Background="{StaticResource TitlebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitlebarDrag">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="Assets/titlebar-icon.png" Width="16" Height="16"/>
                    <TextBlock Text="DeskGuest" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="46" Height="39" Background="Transparent" BorderThickness="0" Click="OnMinimize">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                    </Button>
                    <Button Width="46" Height="39" Background="Transparent" BorderThickness="0" Click="OnMaximise">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                    </Button>
                    <Button Width="46" Height="39" Background="Transparent" BorderThickness="0" Click="OnClose">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Settings rail (kit sidebar: navy, active = Guest Blue pill) ===== -->
            <Border Grid.Column="0" Background="{StaticResource RailBrush}">
                <StackPanel Margin="12,16,12,12">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,14">
                        <Image Source="Assets/app-icon.png" Width="30" Height="30"/>
                        <TextBlock Text="DeskGuest" FontSize="16" FontWeight="ExtraBold"
                                   Foreground="#F2F6F9" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="{StaticResource RailSearchBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="14" Height="14" VerticalAlignment="Center">
                                <Ellipse Width="8.5" Height="8.5" Canvas.Left="0.5" Canvas.Top="0.5"
                                         Stroke="#A8C0D4" StrokeThickness="1.6"/>
                                <Path Data="M 8,8 L 13,13" Stroke="#A8C0D4" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                            <TextBlock Text="Search settings" FontSize="13" Foreground="#A8C0D4" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Profile -->
                    <Border Style="{StaticResource RailItem}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18">
                                <Ellipse Width="7" Height="7" Canvas.Left="5.5" Canvas.Top="1.5" Stroke="#A8C0D4" StrokeThickness="1.6"/>
                                <Path Data="M 2.5,16.5 C 2.5,12.8 5.6,11 9,11 C 12.4,11 15.5,12.8 15.5,16.5" Stroke="#A8C0D4" StrokeThickness="1.6" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                            <TextBlock Text="Profile" Style="{StaticResource RailLabel}"/>
                        </StackPanel>
                    </Border>
                    <!-- General -->
                    <Border Style="{StaticResource RailItem}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18">
                                <Path Data="M2,2 h5.5 v5.5 H2 Z M10.5,2 H16 v5.5 h-5.5 Z M2,10.5 h5.5 V16 H2 Z M10.5,10.5 H16 V16 h-5.5 Z" Stroke="#A8C0D4" StrokeThickness="1.5" Fill="Transparent"/>
                            </Canvas>
                            <TextBlock Text="General" Style="{StaticResource RailLabel}"/>
                        </StackPanel>
                    </Border>
                    <!-- Preferences -->
                    <Border Style="{StaticResource RailItem}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18">
                                <Path Data="M2,4.5 H16 M2,9 H16 M2,13.5 H16" Stroke="#A8C0D4" StrokeThickness="1.6" StrokeStartLineCap="Round"/>
                                <Ellipse Width="5" Height="5" Canvas.Left="10.5" Canvas.Top="2" Fill="#0F2537" Stroke="#A8C0D4" StrokeThickness="1.6"/>
                                <Ellipse Width="5" Height="5" Canvas.Left="3" Canvas.Top="6.5" Fill="#0F2537" Stroke="#A8C0D4" StrokeThickness="1.6"/>
                                <Ellipse Width="5" Height="5" Canvas.Left="8" Canvas.Top="11" Fill="#0F2537" Stroke="#A8C0D4" StrokeThickness="1.6"/>
                            </Canvas>
                            <TextBlock Text="Preferences" Style="{StaticResource RailLabel}"/>
                        </StackPanel>
                    </Border>
                    <!-- Security -->
                    <Border Style="{StaticResource RailItem}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18">
                                <Path Data="M9,1.5 L15,3.8 V8.5 C15,12.8 12.3,15.4 9,16.8 C5.7,15.4 3,12.8 3,8.5 V3.8 Z" Stroke="#A8C0D4" StrokeThickness="1.6" Fill="Transparent" StrokeLineJoin="Round"/>
                            </Canvas>
                            <TextBlock Text="Security" Style="{StaticResource RailLabel}"/>
                        </StackPanel>
                    </Border>
                    <!-- Recovery (active) -->
                    <Border Style="{StaticResource RailItem}" Background="{StaticResource BlueBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18">
                                <Ellipse Width="8" Height="8" Canvas.Left="1.5" Canvas.Top="8" Stroke="#FFFFFF" StrokeThickness="1.7"/>
                                <Path Data="M 8,10.5 L 15.5,3 M 12.8,5.8 L 15.3,8.3 M 10.6,8 L 13.1,10.5" Stroke="#FFFFFF" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                            <TextBlock Text="Recovery" FontSize="13" FontWeight="Bold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Presence -->
                    <Border Style="{StaticResource RailItem}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18">
                                <Ellipse Width="4.5" Height="4.5" Canvas.Left="6.75" Canvas.Top="6.75" Fill="#A8C0D4"/>
                                <Path Data="M 3.5,3.5 A 7.8,7.8 0 0 1 14.5,3.5 M 3.5,14.5 A 7.8,7.8 0 0 0 14.5,14.5" Stroke="#A8C0D4" StrokeThickness="1.6" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                            <TextBlock Text="Presence" Style="{StaticResource RailLabel}"/>
                        </StackPanel>
                    </Border>
                    <!-- Agents & access -->
                    <Border Style="{StaticResource RailItem}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18">
                                <Path Data="M9,1.5 V4 M4.5,4 h9 a1.5,1.5 0 0 1 1.5,1.5 V13 a1.5,1.5 0 0 1 -1.5,1.5 h-9 A1.5,1.5 0 0 1 3,13 V5.5 A1.5,1.5 0 0 1 4.5,4 Z" Stroke="#A8C0D4" StrokeThickness="1.5" Fill="Transparent"/>
                                <Ellipse Width="2.6" Height="2.6" Canvas.Left="5.6" Canvas.Top="8" Fill="#A8C0D4"/>
                                <Ellipse Width="2.6" Height="2.6" Canvas.Left="9.8" Canvas.Top="8" Fill="#A8C0D4"/>
                            </Canvas>
                            <TextBlock Text="Agents &amp; access" Style="{StaticResource RailLabel}"/>
                        </StackPanel>
                    </Border>
                    <!-- Groups -->
                    <Border Style="{StaticResource RailItem}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18">
                                <Ellipse Width="6" Height="6" Canvas.Left="2" Canvas.Top="2" Stroke="#A8C0D4" StrokeThickness="1.5"/>
                                <Path Data="M 1,15.5 C 1,12.6 3.2,11.2 6,11.2 C 7,11.2 7.9,11.4 8.7,11.8 M 12.5,3.2 C 14.6,3.8 15.8,5.4 15.8,7.2 C 15.8,8.4 15.3,9.5 14.5,10.3 M 11.8,11.4 C 14.3,11.7 16,13 16,15.5" Stroke="#A8C0D4" StrokeThickness="1.5" Fill="Transparent" StrokeStartLineCap="Round"/>
                            </Canvas>
                            <TextBlock Text="Groups" Style="{StaticResource RailLabel}"/>
                        </StackPanel>
                    </Border>
                    <!-- Updates -->
                    <Border Style="{StaticResource RailItem}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18">
                                <Path Data="M 15,9 A 6,6 0 1 1 12.8,3.9 M 15.2,1.8 V5 H11.8" Stroke="#A8C0D4" StrokeThickness="1.6" Fill="Transparent" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                            <TextBlock Text="Updates" Style="{StaticResource RailLabel}"/>
                        </StackPanel>
                    </Border>
                    <!-- Backups -->
                    <Border Style="{StaticResource RailItem}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18">
                                <Ellipse Width="15" Height="15" Canvas.Left="1.5" Canvas.Top="1.5" Stroke="#A8C0D4" StrokeThickness="1.5"/>
                                <Path Data="M 9,5.5 V9.5 L 12,11.5" Stroke="#A8C0D4" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                            <TextBlock Text="Backups" Style="{StaticResource RailLabel}"/>
                        </StackPanel>
                    </Border>
                    <!-- Alerts -->
                    <Border Style="{StaticResource RailItem}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18">
                                <Path Data="M9,2 a4.8,4.8 0 0 1 4.8,4.8 c0,3.2 1.2,4.4 1.7,5.2 H2.5 c.5,-0.8 1.7,-2 1.7,-5.2 A4.8,4.8 0 0 1 9,2 Z M7.3,14.8 a1.9,1.9 0 0 0 3.4,0" Stroke="#A8C0D4" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round"/>
                            </Canvas>
                            <TextBlock Text="Alerts" Style="{StaticResource RailLabel}"/>
                        </StackPanel>
                    </Border>
                    <!-- About -->
                    <Border Style="{StaticResource RailItem}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18">
                                <Ellipse Width="15" Height="15" Canvas.Left="1.5" Canvas.Top="1.5" Stroke="#A8C0D4" StrokeThickness="1.5"/>
                                <Path Data="M 9,8 V13.5" Stroke="#A8C0D4" StrokeThickness="1.7" StrokeStartLineCap="Round"/>
                                <Ellipse Width="2.4" Height="2.4" Canvas.Left="7.8" Canvas.Top="4.6" Fill="#A8C0D4"/>
                            </Canvas>
                            <TextBlock Text="About" Style="{StaticResource RailLabel}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Content ===== -->
            <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Width="920" HorizontalAlignment="Center" Margin="0,14,0,18">
                    <TextBlock Text="Settings — Recovery" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Ways back in" FontSize="27" FontWeight="ExtraBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="There is no account and no cloud to rescue you — so if every device you own was lost today, these are the doors that would still open."
                               FontSize="13.5" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="700" Margin="0,5,0,12"/>

                    <!-- Health header -->
                    <Border Style="{StaticResource Card}" BorderBrush="{StaticResource TealBrush}" BorderThickness="2" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource BadgeTealBg}" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M12,2.5 L19.5,5.3 V11 C19.5,16.2 16.2,19.6 12,21.5 C7.8,19.6 4.5,16.2 4.5,11 V5.3 Z" Stroke="{StaticResource TealBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round"/>
                                    <Path Data="M 8.3,11.8 L 10.9,14.4 L 15.8,9.2" Stroke="{StaticResource TealBrush}" StrokeThickness="1.9" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="You have 2 ways back in" FontSize="17" FontWeight="ExtraBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Two doors are ready now. The other three are here whenever you want them — one is enough, more is safer."
                                           FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Door 1: Another of your devices (set up) -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{StaticResource IconTileBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M3,6.5 h12.5 V16 H3 Z M1.5,19 h15" Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round"/>
                                    <Path Data="M17.5,4.5 h4 v13 h-4 Z" Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" Fill="Transparent" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Another of your devices" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Any device that is already yours can welcome a new one in. You have 3 that can do this."
                                           FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Border Background="{StaticResource BadgeTealBg}" CornerRadius="999" Padding="10,4" HorizontalAlignment="Right">
                                    <TextBlock Text="Set up" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BadgeTealText}"/>
                                </Border>
                                <Button Style="{StaticResource QuietBtn}" Content="See your devices" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Door 2: Encrypted recovery file (set up) -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{StaticResource IconTileBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M7,3 h7 l4,4 v14 H7 Z M14,3 v4 h4" Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round"/>
                                    <Ellipse Width="3" Height="3" Canvas.Left="10.5" Canvas.Top="12.5" Fill="{StaticResource IconBrush}"/>
                                    <Path Data="M 12,15.5 V18" Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Encrypted recovery file" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="A file sealed with a password only you know. Keep it anywhere — it is useless without the password."
                                           FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                <TextBlock Text="Saved 12 November 2026" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Border Background="{StaticResource BadgeTealBg}" CornerRadius="999" Padding="10,4" HorizontalAlignment="Right">
                                    <TextBlock Text="Set up" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BadgeTealText}"/>
                                </Border>
                                <Button Style="{StaticResource QuietBtn}" Content="Save a fresh copy" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Door 3: A trusted person (not set up) -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{StaticResource IconTileBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Canvas.Left="3" Canvas.Top="2.5" Stroke="{StaticResource IconBrush}" StrokeThickness="1.7"/>
                                    <Path Data="M 2,20.5 C 2,16.4 5,14.6 8.5,14.6 C 10.4,14.6 12.1,15.2 13.2,16.4" Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" Fill="Transparent" StrokeStartLineCap="Round"/>
                                    <Path Data="M17.5,13.5 L21,14.8 V18 C21,20.4 19.6,21.9 17.5,22.7 C15.4,21.9 14,20.4 14,18 V14.8 Z" Stroke="{StaticResource TealBrush}" StrokeThickness="1.6" Fill="Transparent" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="A trusted person" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Someone you trust holds a sealed piece on their device and taps approve when you ask. The piece alone opens nothing."
                                           FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Border Background="{StaticResource BadgeMutedBg}" CornerRadius="999" Padding="10,4" HorizontalAlignment="Right">
                                    <TextBlock Text="Not set up" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BadgeMutedText}"/>
                                </Border>
                                <Button Style="{StaticResource PrimaryBtn}" Content="Choose a person" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Door 4: Split shares (not set up) -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{StaticResource IconTileBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="10.5" Height="10.5" Canvas.Left="1.5" Canvas.Top="1.5" Stroke="{StaticResource IconBrush}" StrokeThickness="1.7"/>
                                    <Ellipse Width="10.5" Height="10.5" Canvas.Left="12" Canvas.Top="1.5" Stroke="{StaticResource IconBrush}" StrokeThickness="1.7"/>
                                    <Ellipse Width="10.5" Height="10.5" Canvas.Left="6.75" Canvas.Top="11" Stroke="{StaticResource IconBrush}" StrokeThickness="1.7"/>
                                </Canvas>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Split shares" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Your way back, split into 3 pieces kept in different places. Any 2 bring you back — 1 alone is worthless."
                                           FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Border Background="{StaticResource BadgeMutedBg}" CornerRadius="999" Padding="10,4" HorizontalAlignment="Right">
                                    <TextBlock Text="Not set up" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BadgeMutedText}"/>
                                </Border>
                                <Button Style="{StaticResource PrimaryBtn}" Content="Create shares" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Door 5: Word sheet (not set up) -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{StaticResource IconTileBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M9.5,5.5 H21 M9.5,12 H21 M9.5,18.5 H21" Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round"/>
                                    <Path Data="M3,4 h3 v3 H3 Z M3,10.5 h3 v3 H3 Z M3,17 h3 v3 H3 Z" Stroke="{StaticResource IconBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                                </Canvas>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Word sheet" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="34 words on paper, kept somewhere safe. This device will ask you to unlock before it shows them."
                                           FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Border Background="{StaticResource BadgeMutedBg}" CornerRadius="999" Padding="10,4" HorizontalAlignment="Right">
                                    <TextBlock Text="Not set up" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BadgeMutedText}"/>
                                </Border>
                                <Button Style="{StaticResource PrimaryBtn}" Content="Show my words" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- The honest trade -->
                    <Border Style="{StaticResource Card}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource GoldTileBrush}" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M12,2.5 L19.5,5.3 V11 C19.5,16.2 16.2,19.6 12,21.5 C7.8,19.6 4.5,16.2 4.5,11 V5.3 Z" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineJoin="Round"/>
                                    <Path Data="M 12,8 V13.5" Stroke="{StaticResource GoldBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round"/>
                                    <Ellipse Width="2.6" Height="2.6" Canvas.Left="10.7" Canvas.Top="16" Fill="{StaticResource GoldBrush}"/>
                                </Canvas>
                            </Border>
                            <TextBlock FontSize="13.5" Foreground="{StaticResource TextBrush}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Width="800">
                                <Run FontWeight="Bold">The honest trade: </Run>
                                <Run>every way back in is also a way in for someone else. That is why each one is sealed — a file locked by your password, a piece that is useless on its own, words shown only after you unlock. One door is enough. More doors, kept in more places, is safer.</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
