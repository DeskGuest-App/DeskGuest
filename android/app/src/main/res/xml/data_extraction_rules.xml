<?xml version="1.0" encoding="utf-8"?>
<!--
  No data leaves this app through Android's backup or device-transfer
  systems (0.4.2): a control channel's settings, pairings and logs are
  the owner's, on this device only. Pairs with allowBackup="false" —
  a reinstall starts truly fresh instead of restoring a prior
  install's state (the ghost-state failure of 2026-11-15).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
